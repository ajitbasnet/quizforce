# Supabase (optional — history sync when configured)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side — primary + fallback for /api/generate-quiz
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Client dev only — direct calls when VITE_USE_PROXY=false
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GROQ_API_KEY=your-groq-api-key

# Legacy, unused (Anthropic / Claude)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# VITE_ANTHROPIC_API_KEY=your-anthropic-api-key

# Proxy toggle (default true in prod)
VITE_USE_PROXY=true

# Optional: CORS allowlist for API (comma-separated origins)
ALLOWED_ORIGINS=https://your-domain.vercel.app,http://localhost:5173,http://localhost:5174
