# Supabase (optional — history sync when configured)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — used by /api/generate-quiz Edge Function
ANTHROPIC_API_KEY=your-anthropic-api-key

# Client dev only — direct Anthropic calls when VITE_USE_PROXY=false
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key

# Proxy toggle (default true in prod)
VITE_USE_PROXY=true

# Optional: CORS allowlist for API (comma-separated origins)
ALLOWED_ORIGINS=https://your-domain.vercel.app,http://localhost:5173
