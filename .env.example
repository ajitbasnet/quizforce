# Server-side key for /api/generate-quiz (production and local proxy via `vercel dev` or vite middleware)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Client-side key for direct Anthropic calls in development only (set VITE_USE_PROXY=false)
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key

# Use the /api/generate-quiz proxy in development (default: true). Set to false for direct API calls.
VITE_USE_PROXY=true
